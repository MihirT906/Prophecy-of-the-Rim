{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stationNames",
    "planetNames",
    "greetings",
    "offers",
    "farewells",
    "encounters",
    "hazards"
  ],
  "properties": {
    "stationNames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "planetNames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "greetings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "offers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "farewells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "minDanger",
          "weight",
          "countMin",
          "countMax"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "patrol",
              "ambush",
              "stalker"
            ]
          },
          "minDanger": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "weight": {
            "type": "number",
            "minimum": 1,
            "maximum": 20
          },
          "countMin": {
            "type": "number",
            "minimum": 1,
            "maximum": 10
          },
          "countMax": {
            "type": "number",
            "minimum": 1,
            "maximum": 10
          }
        }
      }
    },
    "hazards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "minDanger",
          "radius",
          "strength"
        ],
        "properties": {
          "kind": {
            "enum": [
              "debris-field",
              "ion-cloud"
            ]
          },
          "minDanger": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "radius": {
            "type": "number",
            "minimum": 100,
            "maximum": 2000
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
