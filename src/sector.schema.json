{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Procedural solar system tuning",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "width",
    "height",
    "cruiseSpeed",
    "thrust",
    "brake",
    "asteroids",
    "planetCount",
    "orbitSeconds",
    "trailSeconds",
    "drag",
    "gravity"
  ],
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 96,
      "maximum": 768
    },
    "height": {
      "type": "integer",
      "minimum": 96,
      "maximum": 768
    },
    "cruiseSpeed": {
      "type": "number",
      "minimum": 40,
      "maximum": 600
    },
    "thrust": {
      "type": "number",
      "minimum": 5,
      "maximum": 4000
    },
    "brake": {
      "type": "number",
      "minimum": 10,
      "maximum": 4000
    },
    "asteroids": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000
    },
    "planetCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "orbitSeconds": {
      "type": "number",
      "minimum": 120,
      "maximum": 3600
    },
    "trailSeconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 20
    },
    "drag": {
      "type": "number",
      "minimum": 0,
      "maximum": 4
    },
    "gravity": {
      "type": "number",
      "minimum": 0,
      "maximum": 250
    }
  }
}
